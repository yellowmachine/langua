# Copy to .env.prod, fill in real values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Unlike .env.example (dev), there are no working defaults here for secrets —
# generate your own before exposing this to your family/network.

# Postgres
POSTGRES_USER=langua
POSTGRES_PASSWORD=
POSTGRES_DB=langua
APP_DB_USER=langua_app
APP_DB_PASSWORD=

# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL this instance will be reached at (used for auth cookies/CORS).
ORIGIN=http://localhost:3000
# Image tag to pull from ghcr.io/yellowmachine/langua (built by
# .github/workflows/docker-build.yml). Pin to a sha/version tag to avoid
# tracking main.
APP_IMAGE_TAG=latest

# Seilide: sign-in (OpenID Connect) and AI, paid for by each user's family.
# The three lines come from Seilide's /admin/apps — see README → Seilide.
SEILIDE_URL=https://seilide.app
SEILIDE_CLIENT_ID=
SEILIDE_CLIENT_SECRET=
# OpenRouter model id Seilide is asked for.
OPENROUTER_MODEL=openai/gpt-4o-mini
# Speech-to-text model.
STT_MODEL=Systran/faster-whisper-small
