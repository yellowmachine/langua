# Postgres (used by compose.yaml and DATABASE_URL below)
POSTGRES_USER="langua"
POSTGRES_PASSWORD="langua"
POSTGRES_DB="langua"

# Drizzle
DATABASE_URL="postgres://langua:langua@localhost:5432/langua"

# better-auth — generate a real secret for any non-local environment, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me"
BETTER_AUTH_URL="http://localhost:5173"
