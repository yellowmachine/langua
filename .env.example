# Postgres superuser (used by compose.yaml to init the database + run migrations)
POSTGRES_USER="langua"
POSTGRES_PASSWORD="langua"
POSTGRES_DB="langua"

# Postgres app role: no superuser/owner privileges, so Row-Level Security
# policies are actually enforced (RLS is bypassed for superusers and table
# owners). The running app connects as this role.
APP_DB_USER="langua_app"
APP_DB_PASSWORD="langua_app"

# Drizzle: DATABASE_URL is what the app uses at runtime (restricted role).
# MIGRATION_DATABASE_URL is only for drizzle-kit (creates tables/policies,
# needs owner privileges).
DATABASE_URL="postgres://langua_app:langua_app@localhost:5432/langua"
MIGRATION_DATABASE_URL="postgres://langua:langua@localhost:5432/langua"

# better-auth — generate a real secret for any non-local environment, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me"
BETTER_AUTH_URL="http://localhost:5173"

# Encrypts API keys (e.g. OpenRouter) stored in app_settings. This is a
# dev-only value so a fresh clone works out of the box — generate a real one
# for any non-local environment with: openssl rand -base64 32
ENCRYPTION_KEY="WPip7tkQwq7kZC82Or8yThkRT7t6TyW8oSQRcSHrs+g="

# Chat: local fallback when no OpenRouter key is configured in Settings.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="qwen2.5:1.5b"
