# Postgres superuser (used by compose.yaml to init the database + run migrations)
POSTGRES_USER="langua"
POSTGRES_PASSWORD="langua"
POSTGRES_DB="langua"

# Postgres app role: no superuser/owner privileges, so Row-Level Security
# policies are actually enforced (RLS is bypassed for superusers and table
# owners). The running app connects as this role.
APP_DB_USER="langua_app"
APP_DB_PASSWORD="langua_app"

# Drizzle: DATABASE_URL is what the app uses at runtime (restricted role).
# MIGRATION_DATABASE_URL is only for drizzle-kit (creates tables/policies,
# needs owner privileges).
DATABASE_URL="postgres://langua_app:langua_app@localhost:5432/langua"
MIGRATION_DATABASE_URL="postgres://langua:langua@localhost:5432/langua"

# better-auth — generate a real secret for any non-local environment, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="dev-only-secret-change-me"
BETTER_AUTH_URL="http://localhost:5173"

# Seilide: sign-in (OpenID Connect) and AI, paid for by each user's family.
# The three lines come from Seilide's /admin/apps — see README → Seilide.
# Seilide only accepts https callbacks that aren't localhost, so in dev
# BETTER_AUTH_URL has to be a tunnel's https URL.
SEILIDE_URL="https://nube.scholio.review"
SEILIDE_CLIENT_ID=""
SEILIDE_CLIENT_SECRET=""
# OpenRouter model id Seilide is asked for.
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Text-to-speech: local Piper server (docker/tts) and its on-disk audio cache.
TTS_BASE_URL="http://localhost:5002"
AUDIO_CACHE_DIR="./data/audio"

# Audio clips sent in by integrations (JellyCartoon) via /api/v1/clips.
CLIPS_DIR="./data/clips"

# Speech-to-text: local faster-whisper-server, used by the Hablar module.
STT_BASE_URL="http://localhost:5004"
STT_MODEL="Systran/faster-whisper-small"
